{
  "manifest_version": 3,
  "name": "Nydia: Passkey Holder",
  "version": "1.0.3",
  "description": "Passkey storage on the Sia network. Hold your passkeys locally with decentralized backup.",
  "author": "Oleh Nypadymka",
  "browser_specific_settings": {
    "gecko": {
      "id": "extension@nydia.app",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "optional_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://localhost/*"
      ],
      "js": [
        "dispatcher.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "injector.js",
        "icon.png",
        "popup.html",
        "popup.js",
        "popup.css"
      ],
      "matches": [
        "https://*/*",
        "http://localhost/*"
      ]
    }
  ],
  "action": {
    "default_popup": "menu.html",
    "default_title": "Nydia: Passkey Holder"
  },
  "icons": {
    "128": "icon.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
