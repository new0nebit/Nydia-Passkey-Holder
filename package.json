{
  "name": "Nydia-Passkey-Holder",
  "version": "1.0.3",
  "description": "Browser extension for decentralized passkey storage on the Sia network.",
  "author": "Oleh N.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/new0nebit/Nydia-Passkey-Holder.git"
  },
  "keywords": [
    "passkey",
    "webauthn",
    "browser-extension",
    "sia-network",
    "decentralized-storage",
    "authenticator",
    "security"
  ],
  "scripts": {
    "build": "npm run build:chrome && npm run build:firefox && npm run build:safari",
    "debug": "npm run build:chrome:debug && npm run build:firefox:debug && npm run build:safari:debug",
    "build:chrome": "webpack --mode production --env target=chrome",
    "build:chrome:debug": "webpack --mode production --env target=chrome --env keepDebug=true",
    "build:firefox": "webpack --mode production --env target=firefox",
    "build:firefox:debug": "webpack --mode production --env target=firefox --env keepDebug=true",
    "build:safari": "webpack --mode production --env target=safari",
    "build:safari:debug": "webpack --mode production --env target=safari --env keepDebug=true",
    "dev": "npm-run-all --parallel --continue-on-error dev:chrome dev:firefox dev:safari",
    "dev:chrome": "webpack --watch --mode development --env target=chrome",
    "dev:firefox": "webpack --watch --mode development --env target=firefox",
    "dev:safari": "webpack --watch --mode development --env target=safari",
    "lint": "eslint 'src/**/*.{js,ts}' tests",
    "test": "tsc -p tests/tsconfig.json && node --test tests/*.test.mjs",
    "type-check": "tsc --noEmit",
    "check": "npm-run-all --continue-on-error lint type-check",
    "analyze": "webpack --mode production --env analyze"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.1.43",
    "@types/firefox-webext-browser": "^143.0.1",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.5",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "mini-css-extract-plugin": "^2.10.2",
    "npm-run-all": "^4.1.5",
    "terser-webpack-plugin": "^5.6.1",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "webpack": "^5.112.2",
    "webpack-bundle-analyzer": "^5.4.0",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "tldts": "^7.4.19"
  }
}
